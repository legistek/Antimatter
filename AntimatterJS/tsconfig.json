{
  "compilerOptions": {
    "baseUrl": ".",
    "noEmitOnError": true,
    "removeComments": false,    
    "moduleResolution": "Node",
    "target": "es2019",
    "lib": [ "es2019", "dom" ],
    "strict": true,
    "sourceMap": false,
    "declaration": false,    
    "module": "ESNext",
    "jsx": "react",
    "listFiles": true,
    "noImplicitAny": false
  },
  "include": ["src"],
  "exclude": [
    "node_modules"
  ]
}
