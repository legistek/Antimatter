<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ReactFun2026_07.Server</RootNamespace>
		<SpaRoot>..\antimatter.test.client</SpaRoot>
		<SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
		<SpaProxyServerUrl>https://localhost:44317</SpaProxyServerUrl>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="ClientApp\**" />
	  <Content Remove="ClientApp\**" />
	  <EmbeddedResource Remove="ClientApp\**" />
	  <None Remove="ClientApp\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Antimatter.NET\Antimatter.Net.Hosting\Antimatter.Net.Hosting.csproj" />
		<ProjectReference Include="..\antimatter.test.client.model\antimatter.test.client.model.csproj" />
		<ProjectReference Include="..\antimatter.test.client\antimatter.test.client.esproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.SpaProxy">
			<Version>10.*-*</Version>
		</PackageReference>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.12" />
	</ItemGroup>

</Project>
