{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": [ "ES2023", "DOM" ],
    "module": "esnext",
    // "node" because tsc -b type-checks the shared library sources this project
    // imports, and they use process.env. An explicit "types" list turns OFF automatic
    // @types inclusion, so anything needed must be named here.
    "types": [ "vite/client", "node" ],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,

    "composite": true
  },
  "include": [ "src" ],
  "files": [
    "../../../node_modules/ts-nameof/ts-nameof.d.ts"
  ]
}
