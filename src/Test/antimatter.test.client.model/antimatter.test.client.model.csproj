<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
		<RunAOTCompilation>false</RunAOTCompilation>
		<EmccTotalMemory>134217728</EmccTotalMemory>
		<!-- Force WASM debugging on. Without these the debugger can read the boot
		     config as a non-debuggable (release) app and refuse to load the module. -->
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<Optimize>false</Optimize>
		<WasmDebugLevel>1</WasmDebugLevel>
		<!-- The server consumes this project's wwwroot/_framework output, not its
		     assembly. Visual Studio's fast up-to-date check does not track that, so it
		     skips the build and the server serves stale WASM. Disable it here. -->
		<DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Antimatter.NET\Antimatter.Net.Core\Antimatter.Net.Core.csproj" />
	  <ProjectReference Include="..\..\Antimatter.NET\Antimatter.Net.Webassembly\Antimatter.Net.Webassembly.csproj" />
	  <ProjectReference Include="..\antimatter.test.client.model.app\antimatter.test.client.model.app.csproj" />
	</ItemGroup>
</Project>
