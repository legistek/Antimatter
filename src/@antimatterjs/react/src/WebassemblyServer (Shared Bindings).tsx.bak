    private _lastRefresh: number = 0;

    OnUserActivity(silent?: boolean)
    {
        var act = (new Date()).getTime();
        localStorage.setItem('lastActivity', act.toString());
        if (silent)
            // Model is informing us that it knows of a non-idle event that
            // we don't, so we can just update our lastRefresh time to reflect this
            this._lastRefresh = act;
        else if (act > this._lastRefresh + 120000)
        {            
            // inform model only if it's been more than 2 minutes
            this.NotifyModelOfUserActivity();
            this._lastRefresh = act;
        }        
    }

    private NotifyModelOfUserActivity()
    {
        if (!this._notifyUserNotIdleMethod)
        {
            this._notifyUserNotIdleMethod = this.Module.mono_bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "NotifyUserNotIdle"));            
        }
        this._notifyUserNotIdleMethod();
    }

    OnForceLogout(): void
    {
        if (!this._onForceLogoutMethod)
        {
            this._onForceLogoutMethod = this.Module.mono_bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "OnForceLogout"));
            this._onForceLogoutMethod();
        }
    }

    ExecuteICommand(netRef: ModelObjectReference, parameter?: any): Promise<void>
    {
        if (!this._executeICommandMethod)
        {
            this._executeICommandMethod = this.Module.mono_bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "ExecuteICommandUnmarshalled"),
            "im");
        }
        let ptr: number = 0;
        if (parameter !== null && parameter !== undefined)
        {
            parameter = ModelValue.Get(parameter);
            ptr = this.createManagedModelValue(parameter) as any as number;
        }
        
        this._executeICommandMethod(netRef.Handle, ptr);
        // TODO - FREE OBJECTS??
        return Promise.resolve();
    }

    InvokeBeforeClose(): boolean
    {
        if (!this._invokeBeforeClose)
        {
            this._invokeBeforeClose = this.Module.mono_bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "InvokeBeforeClose"));
        }
        return this._invokeBeforeClose() as boolean;        
    }

    ParseLocallyFormattedDate(date: string): Date
    {
        if (!this._executeParseLocallyFormattedDateMethod)
        {
            this._executeParseLocallyFormattedDateMethod = this.Module.mono_bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "ParseLocallyFormattedDate"));
        }
        var dateNum = this._executeParseLocallyFormattedDateMethod(date) as number;
        return Utilities.DateFromTicks(dateNum);
    }

    InvokeModelObjectMethod(netRef: ModelObjectReference | number, method: string, args?: any[]): any
    {
        if (!this._executeModelMethod)
        {
            this._executeModelMethod = this.Module.mono_bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "InvokeModelObjectMethod"));
        }

        if (args)
            args = args.map((arg) => ModelValue.Get(arg));

        var ptrptr = this._executeModelMethod(
            typeof (netRef) === 'number' ? netRef : netRef.Handle,
            method,
            args
                ? JSON.stringify(args)
                : null);
        
        if (ptrptr)
        {
            var valuePtr = this.DotNet.BINDING.js_to_mono_obj(ptrptr) as any as number;
            var type = this.getValueI16(valuePtr + 8) as ModelValueType;
            var val = this.getModelValue(valuePtr, type);
            // We got what we needed; free it for GC since .NET gave us a
            // GC-aware reference.
            var gch = ptrptr[js_owned_gc_handle];
            this.DotNet.BINDING._release_js_owned_object_by_gc_handle(gch);
            return val;
        }
        else
        {
            return undefined;
        }                
    }

    CreateActualBindingKey(handle: number, path: string, exp: BindingExpression): string
    {
        return `${handle}`
            + `.${path}`
            + `.${exp.Parameters?.Mode || BindingMode.OneWay}`
            + `.${exp.Parameters.MarshalValue || 0}`
            + `.${exp.Parameters.ModelSideConverter || 0}`
            //+ `.${exp.Parameters.RelativeSource || 0}`
            //+ `.${exp.Parameters.RelativeSourceMode || 0}`
            ;
    }

    private static _trueBindingsByKey = new Map<string, TrueBinding>();
    private static _trueBindingsByModelIndex = new Map<number, TrueBinding>();
    private static _trueBindingsByBxIndex = new Map<number, TrueBinding>();
    private static _nextTrueBindingIndex: number = 0;
    private static _redundantBindingsAvoided: number = 0;
    private static _trueBindings: number = 0;

    Bind(ref: ModelObjectReference, path: string, expression: BindingExpression)
    {
        if (ref === undefined)
            return;

        if (!this._bindMethod)
        {
            this._bindMethod = this.Module.mono_bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "Bind"));
        }

        var key = this.CreateActualBindingKey(ref.Handle, path, expression);
        let trueBinding: TrueBinding | undefined = undefined;
        if (trueBinding = WebassemblyServer._trueBindingsByKey.get(key))
        {
            trueBinding.Expressions.push(expression);
            WebassemblyServer._trueBindingsByBxIndex.set(expression.Index, trueBinding);
            BindingExpression.OnModelValueChanged(
                expression.Index,
                trueBinding.LastValue,
                trueBinding.LastValueType || ModelValueType.Null);
            WebassemblyServer._redundantBindingsAvoided++;
            return;
        }
        trueBinding = {
            Expressions: [expression],
            ModelBindingIndex: WebassemblyServer._nextTrueBindingIndex++
        };
        WebassemblyServer._trueBindings++;
        WebassemblyServer._trueBindingsByKey.set(key, trueBinding);
        WebassemblyServer._trueBindingsByModelIndex.set(trueBinding.ModelBindingIndex, trueBinding);
        WebassemblyServer._trueBindingsByBxIndex.set(expression.Index, trueBinding);

        this._bindMethod(
            ref.Handle,
            path ? path : null,
            trueBinding.ModelBindingIndex,
            expression.Parameters?.Mode || BindingMode.OneWay,
            expression.Parameters?.MarshalValue || false,
            expression.Parameters?.ModelSideConverter ? expression.Parameters?.ModelSideConverter : null
        );
    }

    Unbind(bx: BindingExpression)
    {
        if (!this._unbindMethod)
        {
            this._unbindMethod = this.Module.mono_bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "Unbind"));
        }

        if (!bx._resolvedSource?.NetRef?.Handle)
            return;

        var key = this.CreateActualBindingKey(
            bx._resolvedSource.NetRef.Handle,
            bx.Parameters?.Path || "",
            bx);
        var trueBinding = WebassemblyServer._trueBindingsByKey.get(key);
        if (!trueBinding)
            // Should be impossible
            return;

        var expIndex = trueBinding.Expressions.findIndex(e => e === bx);
        if (expIndex === -1)
            // Should be impossible
            return;
        trueBinding.Expressions.splice(expIndex, 1);
        WebassemblyServer._trueBindingsByBxIndex.delete(bx.Index);
        if (trueBinding.Expressions.length === 0)
        {
            this._unbindMethod(trueBinding.ModelBindingIndex);
            WebassemblyServer._trueBindingsByKey.delete(key);
            WebassemblyServer._trueBindingsByModelIndex.delete(trueBinding.ModelBindingIndex);
        }
    }

    GetCollectionMembers(handle: number, offset: number, count: number)
    {
        if (!this._getCollectionMembers)
        {
            this._getCollectionMembers = this.DotNet.BINDING.bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "GetCollectionMembers"),
                "iii");
        }
        var ptrptr = this._getCollectionMembers(handle, offset, count);
        var mo = this.DotNet.BINDING.js_to_mono_obj(ptrptr);
        var val = this.getArrayValue(mo as any as number, true);
        if (ptrptr)
        {
            // We got what we needed; free it for GC since .NET gave us a
            // GC-aware reference.
            var gch = ptrptr[js_owned_gc_handle];
            this.DotNet.BINDING._release_js_owned_object_by_gc_handle(gch);
        }
        return val;
    }

    GetCollectionSize(handle: number): number
    {
        if (!this._getCollectionSize)
        {
            this._getCollectionSize = this.DotNet.BINDING.bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "GetCollectionSize"),
                "i");
        }
        return this._getCollectionSize(handle);
    }

    UpdateBindingSource(bxIndex: number, value: any)
    {
        if (!this._updateSourceValueMethod)
        {
            this._updateSourceValueMethod = this.DotNet.BINDING.bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "UpdateBindingSourceUnmarshalled"),
                "im");
        }

        var trueBinding = WebassemblyServer._trueBindingsByBxIndex.get(bxIndex);
        if (!trueBinding)
            // Should be impossible
            return;

        var mv = ModelValue.Get(value);
        var ptr = this.createManagedModelValue(mv);
        this._updateSourceValueMethod(trueBinding.ModelBindingIndex, ptr);

        // Need to update the other expressions that might be dependent on this value
        for (var exp of trueBinding.Expressions)
        {
            if (exp.Index === bxIndex)
                continue;
            BindingExpression.OnModelValueChanged(
                exp.Index,
                value,
                mv.Type || ModelValueType.Null);
        }

        // TODO - FREE OBJECTS??
    }

    UpdateBoundCollection(bxIndex: number, value: ICollectionUpdate)
    {
        if (!this._updateBoundCollectionMethod)
        {
            this._updateBoundCollectionMethod = this.Module.mono_bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "UpdateBoundCollection"));
        }

        var trueBinding = WebassemblyServer._trueBindingsByBxIndex.get(bxIndex);
        if (!trueBinding)
            // Should be impossible
            return;

        this._updateBoundCollectionMethod(trueBinding.ModelBindingIndex, JSON.stringify(value));
        // Need to update the other expressions that might be dependent on this value
        for (var exp of trueBinding.Expressions) {
            if (exp.Index === bxIndex)
                continue;
            BindingExpression.OnModelBoundCollectionChanged(
                exp.Index,
                value);
        }
    }

    CreateModelValue(): MonoObject
    {
        if (!this._createModelValueMethod)
        {
            this._createModelValueMethod = this.DotNet.BINDING.bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "CreateModelValue"));
        }
        return this._createModelValueMethod();
    }

    ExecuteCallback(callback: number, value: MonoObject | null)
    {
        if (!this._executeCallbackMethod)
        {
            this._executeCallbackMethod = this.Module.mono_bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "ExecuteCallback"),
                "im");
        }
        this._executeCallbackMethod(callback, value);
    }

    ExecuteCallbackException(callback: number, exception: string)
    {
        if (!this._executeCallbackExceptionMethod)
        {
            this._executeCallbackExceptionMethod = this.Module.mono_bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "ExecuteCallbackException"),
                "im");
        }
        this._executeCallbackExceptionMethod(callback, this.Binding.js_string_to_mono_string(exception));
    }    

    AddRef(handle: number)
    {
        if (!this._addRefMethod)
        {
            this._addRefMethod = this.Module.mono_bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "AddRef"),
                "i");
        }
        this._addRefMethod(handle);
    }

    ReleaseRef(handle: number)
    {
        if (!this._releaseRefMethod)
        {
            this._releaseRefMethod = this.Module.mono_bind_static_method(
                this.MakeMethodKey(
                    WebassemblyServer.c_ServerAssembly,
                    WebassemblyServer.c_ServerType,
                    "ReleaseRef"),
                "i");
        }
        this._releaseRefMethod(handle);
    }

