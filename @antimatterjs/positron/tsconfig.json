{
  "compilerOptions": {
    "baseUrl": ".",
    "noEmitOnError": true,
    "removeComments": false,
    "moduleResolution": "Node",
    "target": "ES2020",
    "lib": [ "ES2020", "ES2020.BigInt", "dom" ],
    "strict": true,
    "sourceMap": false,
    "declaration": false,
    "module": "ESNext",
    "jsx": "react",
    "listFiles": true,
    "noImplicitAny": false
  },
  "include": ["src"],
  "exclude": [
    "node_modules"
  ]
}
